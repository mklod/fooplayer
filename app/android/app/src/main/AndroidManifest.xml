<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Playback has to keep running with the screen off, which on Android
         means a foreground service. mediaPlayback is the specific type
         Android 14+ requires you to declare, and WAKE_LOCK is what stops the
         CPU sleeping mid-track. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Android 13+ will not show the playback notification without this.
         Its absence is silent: playback works, the notification simply never
         appears. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Task 10: LAN sync talks to the NAS over SMB. Declared explicitly so
         a release build doesn't depend on some plugin's merged manifest
         happening to declare it. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- SyncForegroundService: keeps a LAN sync's network alive when the app
         is backgrounded, and shows its progress notification. dataSync is
         the specific foreground-service type Android 14+ requires declaring
         for exactly this kind of background network transfer, distinct
         from FOREGROUND_SERVICE_MEDIA_PLAYBACK above, which only covers
         playback. POST_NOTIFICATIONS is already declared above for the
         playback notification; the sync notification reuses that same
         runtime permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>

    <!-- Reading a music folder the user picked.

         READ_MEDIA_AUDIO (13+) and READ_EXTERNAL_STORAGE (32 and below) cover
         the audio files themselves. They are NOT enough on their own: this
         app keeps its library manifest and artwork sidecar beside the music
         as .library.json / .artwork.json, and those are not media, so the
         media-scoped permissions cannot read them. Without all-files access
         the app can list a folder and not open a single file in it, which is
         exactly how it looked on the tablet: a folder full of tracks and an
         empty library. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage"/>
    <application
        android:label="fooplayer"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- The service that owns playback, and the receiver that delivers
             headset/bluetooth transport buttons to it. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>
        <!-- See SyncForegroundService.kt's class doc. Not exported: only
             this app's own SmbBridge starts it. -->
        <service
            android:name=".SyncForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
