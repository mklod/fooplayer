<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 replaced the old windowBackground splash with a system
         one that draws the LAUNCHER icon, scaled up. Ours is upscaled from
         96px of source art, so that scaling is what made the splash look
         soft and aliased. Pointing the splash at its own asset, generated at
         192dp for every density, at least stops the system enlarging a
         small bitmap. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
