<?xml version="1.0" encoding="utf-8"?>
<!-- The tile behind the note.

     It cannot be removed. Since Android 8 the launcher masks every adaptive
     icon to its own shape and fills it with this layer, which is why every
     icon on the home screen is the same circle. Painting nothing here does
     not give a bare note: it gives a BLACK circle, because the mask is still
     drawn. Dropping the adaptive icon entirely does not help either, since
     the launcher then applies its own legacy treatment and puts the bitmap
     on a white circle regardless (both measured on a Pixel 7, 2026-07-29).

     So the only real choice is what colour the circle is. White matches the
     app's own light theme and the stock icons it sits beside. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
</shape>
